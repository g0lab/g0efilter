FROM golang:1.27.4-alpine@sha256:0a5f7fe796599ff487605987432e7619ae45beeb2fba4c2ce0b907879932aebf AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY agent/go.mod agent/go.sum ./agent/
COPY shared/go.mod shared/go.sum ./shared/
RUN GOWORK=off go -C agent mod download

COPY . .

ENV CGO_ENABLED=0 GOOS=linux
RUN GOWORK=off go -C agent build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter .

# Adds sh, cat and nft so tests can inspect the agent; the image phase covers the
# shipped scratch image built from agent/Containerfile.
FROM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

RUN apk add --no-cache nftables

WORKDIR /app

COPY --from=builder /build/g0efilter /app/g0efilter

RUN apk add --no-cache --virtual .setcap libcap \
    && setcap cap_net_admin=eip /app/g0efilter \
    && setcap cap_net_admin=ep "$(command -v nft)" \
    && getcap /app/g0efilter | grep -q cap_net_admin \
    && apk del .setcap

USER 65534:65534

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter", "healthcheck"]

ENTRYPOINT ["/app/g0efilter"]
