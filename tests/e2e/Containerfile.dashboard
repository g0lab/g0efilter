FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5 AS ui

RUN corepack enable

WORKDIR /ui

COPY dashboard/ui/package.json dashboard/ui/pnpm-lock.yaml dashboard/ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY dashboard/ui/ ./
RUN pnpm build

FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY dashboard/go.mod dashboard/go.sum ./dashboard/
COPY shared/go.mod shared/go.sum ./shared/
RUN GOWORK=off go -C dashboard mod download

COPY . .
COPY --from=ui /ui/dist ./dashboard/ui/dist

ENV CGO_ENABLED=0 GOOS=linux
RUN GOWORK=off go -C dashboard build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter-dashboard .

FROM gcr.io/distroless/static:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5

USER nonroot
WORKDIR /app/data
WORKDIR /app

COPY --from=builder /build/g0efilter-dashboard /app/g0efilter-dashboard

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter-dashboard", "healthcheck"]

ENTRYPOINT ["/app/g0efilter-dashboard"]
