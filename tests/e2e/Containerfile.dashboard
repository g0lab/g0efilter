FROM node:24-alpine@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS ui

RUN corepack enable

WORKDIR /ui

COPY dashboard/ui/package.json dashboard/ui/pnpm-lock.yaml dashboard/ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY dashboard/ui/ ./
RUN pnpm build

FROM golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY dashboard/go.mod dashboard/go.sum ./dashboard/
COPY shared/go.mod shared/go.sum ./shared/
RUN GOWORK=off go -C dashboard mod download

COPY . .
COPY --from=ui /ui/dist ./dashboard/ui/dist

ENV CGO_ENABLED=0 GOOS=linux
RUN GOWORK=off go -C dashboard build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter-dashboard .

FROM gcr.io/distroless/static:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087

USER nonroot
WORKDIR /app/data
WORKDIR /app

COPY --from=builder /build/g0efilter-dashboard /app/g0efilter-dashboard

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter-dashboard", "healthcheck"]

ENTRYPOINT ["/app/g0efilter-dashboard"]
