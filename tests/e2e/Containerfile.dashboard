FROM node:24-alpine@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81 AS ui

RUN corepack enable

WORKDIR /ui

COPY dashboard/ui/package.json dashboard/ui/pnpm-lock.yaml dashboard/ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY dashboard/ui/ ./
RUN pnpm build

FROM golang:1.27.1-alpine@sha256:4cb7ac979db5fcc41cae44b2227ba5ab8a51e8807f40d9ba4dee20a0ad960b5b AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY dashboard/go.mod dashboard/go.sum ./dashboard/
COPY shared/go.mod shared/go.sum ./shared/
RUN GOWORK=off go -C dashboard mod download

COPY . .
COPY --from=ui /ui/dist ./dashboard/ui/dist

ENV CGO_ENABLED=0 GOOS=linux
RUN GOWORK=off go -C dashboard build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter-dashboard .

FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

USER nonroot
WORKDIR /app/data
WORKDIR /app

COPY --from=builder /build/g0efilter-dashboard /app/g0efilter-dashboard

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter-dashboard", "healthcheck"]

ENTRYPOINT ["/app/g0efilter-dashboard"]
