FROM node:24-alpine AS ui

RUN corepack enable

WORKDIR /ui

COPY dashboard/ui/package.json dashboard/ui/pnpm-lock.yaml dashboard/ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY dashboard/ui/ ./
RUN pnpm build

FROM golang:1.26.5-alpine3.23 AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=ui /ui/dist ./dashboard/ui/dist

ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter-dashboard ./dashboard

FROM gcr.io/distroless/static:nonroot

USER nonroot
WORKDIR /app/data
WORKDIR /app

COPY --from=builder /build/g0efilter-dashboard /app/g0efilter-dashboard

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter-dashboard", "healthcheck"]

ENTRYPOINT ["/app/g0efilter-dashboard"]
