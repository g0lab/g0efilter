# Releases copy a prebuilt binary; BINARY=source builds it from the repository root.
ARG BINARY=prebuilt

FROM scratch AS prebuilt

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/g0efilter /g0efilter

FROM --platform=$BUILDPLATFORM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS source

ARG TARGETOS TARGETARCH VERSION=dev COMMIT=unknown DATE=unknown

WORKDIR /build

COPY agent/go.mod agent/go.sum ./agent/
COPY shared/go.mod shared/go.sum ./shared/
RUN GOWORK=off go -C agent mod download

COPY agent ./agent
COPY shared ./shared

RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOWORK=off go -C agent build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /g0efilter .

FROM ${BINARY} AS binary

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS caps

COPY --from=binary /g0efilter /g0efilter

RUN apk add --no-cache libcap \
 && setcap cap_net_admin=eip /g0efilter \
 && getcap /g0efilter | grep -q cap_net_admin

FROM scratch

COPY --from=caps /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=caps /g0efilter /app/g0efilter

WORKDIR /app

USER 65534:65534

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter", "healthcheck"]

ENTRYPOINT ["/app/g0efilter"]
