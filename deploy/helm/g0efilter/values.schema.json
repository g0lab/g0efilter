{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "g0efilter sidecar",
  "description": "Values for the g0efilter egress-filter sidecar library chart.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm injects this into every subchart's scope; g0efilter does not read it.",
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "mode": {
      "description": "Filter mode.",
      "enum": [
        "https",
        "dns",
        "dns-strict"
      ]
    },
    "enforcement": {
      "description": "block drops traffic no rule allows; audit logs it and allows it through.",
      "enum": [
        "block",
        "audit"
      ]
    },
    "logLevel": {
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR"
      ]
    },
    "processInfo": {
      "description": "Needs shareProcessNamespace on the pod, which the consuming chart must set.",
      "type": "boolean"
    },
    "tenantId": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMapName": {
          "type": "string",
          "minLength": 1
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/"
        },
        "fileName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceAccountName": {
          "type": "string",
          "minLength": 1
        },
        "maxDenials": {
          "description": "Null uses the agent default; 0 records no Events at all.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "runAsUser": {
      "description": "Must not be 0: the sidecar is built to run unprivileged.",
      "type": "integer",
      "minimum": 1
    },
    "runAsGroup": {
      "type": "integer",
      "minimum": 1
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "boolean"
        }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "description": "The policy must allow this destination: the sidecar filters its own egress.",
          "type": "string"
        },
        "apiKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "queueSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "startDelay": {
          "description": "A Go duration such as 5s or 1m.",
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"
        },
        "remoteUnblock": {
          "type": "boolean"
        },
        "unblockPollInterval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))*$"
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "description": "The policy must allow this destination: the sidecar filters its own egress.",
          "type": "string"
        },
        "keySecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "backoffSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "ignoreDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreams": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hardening": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "rateQps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "rateBurst": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "https": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        },
        "dns": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "connections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": {
          "description": "0 is unlimited.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxLifetimeMs": {
          "description": "A single absolute deadline, not an idle timeout. 0 disables it.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "nflog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bufSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "qthresh": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
