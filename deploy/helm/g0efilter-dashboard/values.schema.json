{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "g0efilter dashboard",
  "description": "Values for the g0efilter dashboard.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm injects this into every subchart's scope; the chart does not read it.",
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "logLevel": {
      "enum": [
        "TRACE",
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "session",
            "none",
            "forward",
            "jwt"
          ]
        },
        "adminUsername": {
          "type": "string",
          "minLength": 1
        },
        "sessionTtl": {
          "type": "string",
          "pattern": "^([0-9]+(ns|us|ms|s|m|h))+$"
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "forwardAuthHeader": {
          "type": "string",
          "minLength": 1
        },
        "jwt": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "usernameClaim": {
              "type": "string",
              "minLength": 1
            },
            "issuer": {
              "type": "string"
            },
            "audience": {
              "type": "string"
            },
            "jwksUrl": {
              "type": "string"
            },
            "publicKey": {
              "type": "string"
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "apiKey": {
              "type": "string",
              "minLength": 1
            },
            "adminPasswordHash": {
              "type": "string",
              "minLength": 1
            },
            "jwtSecret": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "apiKey": {
          "type": "string"
        },
        "adminPasswordHash": {
          "type": "string"
        },
        "jwtSecret": {
          "type": "string"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod"
          ]
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ephemeral": {
      "type": "boolean"
    },
    "dbPath": {
      "type": "string",
      "pattern": "^/"
    },
    "logRetention": {
      "type": "integer",
      "minimum": 0
    },
    "fleet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bufferSize": {
          "type": "integer",
          "minimum": 1
        },
        "readLimit": {
          "type": "integer",
          "minimum": 1
        },
        "sseRetryMs": {
          "type": "integer",
          "minimum": 0
        },
        "writeTimeout": {
          "description": "Seconds. 0 means none, which server-sent events need.",
          "type": "integer",
          "minimum": 0
        },
        "rateRps": {
          "type": "integer",
          "minimum": 1
        },
        "rateBurst": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "cors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "pathType": {
          "enum": [
            "Exact",
            "Prefix",
            "ImplementationSpecific"
          ]
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
