FROM gcr.io/distroless/static:nonroot@sha256:516757106de35205efb70b91ba03f6f1298424a0678c603255cf2852a7000087

WORKDIR /

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/g0efilter-controller /g0efilter-controller

# distroless/static:nonroot has no shell and defaults to uid 65532.
USER 65532:65532

ENTRYPOINT ["/g0efilter-controller"]
