# Local/dev artifacts
data/
dist/
test/
.trunk/
.dev/

# Node / UI: the dashboard image builds the UI itself in a Node stage, so keep
# host node_modules and the committed dist out of the build context. The UI
# *source* (internal/dashboard/ui/{src,*.html,*.js,package.json,lockfile}) stays.
**/node_modules/
internal/dashboard/ui/dist/
internal/dashboard/ui/.vite/

# Env files
.env

# Go build/test artifacts
*.exe
*.dll
*.so
*.dylib
*.test
*.out
*.coverprofile
coverage.*
profile.cov

# Workspace/tooling
go.work
go.work.sum
eslint.config.mjs

# Repo docs and misc files not required for builds
*.txt
LICENSE
README.md
SECURITY.md

examples/

Dockerfile
Dockerfile.dashboard