# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# Env files (keep example .env files tracked)
.env
!examples/.env
!examples/.env.dashboard

# Editor/IDE
.vscode/

# Dev specific files and directories
data/
dist/
.trunk/
.dev/

# Tooling config
eslint.config.mjs

.claude/

# Local planning scratch (not part of the repo)
/test/

# Helm resolves local library-chart dependencies at build time.
examples/helm/*/charts/
examples/helm/*/Chart.lock
tests/manifests/testdata/*/charts/
tests/manifests/testdata/*/Chart.lock

# Go fuzz discoveries are local artifacts. Preserve regressions as named unit
# tests or inline fuzz seeds instead of opaque hash files.
**/testdata/fuzz/
