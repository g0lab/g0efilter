{
  // Static, backend-free demo of the g0efilter dashboard on Cloudflare Workers.
  // Build with `pnpm build:demo` (sets VITE_DEMO_MODE=true), then
  // `npx wrangler deploy` (or `npx wrangler dev` to preview locally).
  "name": "g0efilter-demo",
  "compatibility_date": "2026-07-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
