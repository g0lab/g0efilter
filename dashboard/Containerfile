FROM gcr.io/distroless/static:nonroot@sha256:f7f8f729987ad0fdf6b05eeeae94b26e6a0f613bdf46feea7fc40f7bd72953e6

USER nonroot
# Pre-create /app/data as nonroot; distroless has no mkdir utility.
WORKDIR /app/data
WORKDIR /app

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/g0efilter-dashboard /app/g0efilter-dashboard

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter-dashboard", "healthcheck"]

ENTRYPOINT ["/app/g0efilter-dashboard"]
