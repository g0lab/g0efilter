FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

USER nonroot
# Pre-create /app/data as nonroot; distroless has no mkdir utility.
WORKDIR /app/data
WORKDIR /app

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/g0efilter-dashboard /app/g0efilter-dashboard

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter-dashboard", "healthcheck"]

ENTRYPOINT ["/app/g0efilter-dashboard"]
