# g0efilter-dashboard configuration
#
# This is a TEMPLATE. API_KEY (below) is required unless a persisted API key
# already exists in DB_PATH; without one the dashboard refuses to start.

# REQUIRED: machine credential g0efilter instances present as X-Api-Key.
API_KEY=your-secure-api-key-here
PORT=:8081
LOG_LEVEL=DEBUG

# Web UI authentication (default: session)
#   session - built-in login form
#   none    - no built-in auth; ONLY behind an authenticating reverse proxy
#   forward - trust FORWARD_AUTH_HEADER set by an authenticating proxy
AUTH_MODE=session
ADMIN_USERNAME=admin
# Optional for AUTH_MODE=session. Leave blank to have a random admin password
# generated and logged ONCE on first startup (look for
# "dashboard.admin_password_generated"); recover it later with the
# 'reset-password' subcommand. Or set your own bcrypt hash here:
#   docker run --rm -i docker.io/g0lab/g0efilter-dashboard:latest hash-password
ADMIN_PASSWORD_HASH=
# Session cookies are marked Secure by default, which browsers only send over
# HTTPS (localhost is exempt). Serving plain HTTP on a LAN address? Either put
# TLS in front (recommended) or set COOKIE_SECURE=false.
# COOKIE_SECURE=true
# SESSION_TTL=24h
# FORWARD_AUTH_HEADER=X-Forwarded-User

# Persistence for sessions, API keys and unblock state (recommended).
# Requires a writable volume (the container runs read-only) - see the
# commented volume in docker-compose.yaml. Unset = in-memory, reset on restart.
# DB_PATH=/app/data/dashboard.db

# SSO via bearer token (AUTH_MODE=jwt). Set exactly one key source:
# JWT_SECRET=...                       # HS256 shared secret
# JWT_PUBLIC_KEY=@/etc/g0efilter/jwt.pem  # RS256/ES256 PEM (inline or @path)
# JWKS_URL=https://idp.example/.well-known/jwks.json
# JWT_ISSUER=https://idp.example
# JWT_AUDIENCE=g0efilter
# JWT_USERNAME_CLAIM=email

# Allow a browser UI on another origin to call the API (comma-separated).
# CORS_ALLOWED_ORIGINS=https://ui.example.com

# Traffic logs persist to SQLite automatically when DB_PATH is set (otherwise
# they use the in-memory ring). LOG_RETENTION caps the stored rows.
# LOG_RETENTION=100000

# Fleet management: dashboard-side preview for instances/groups/policy
# (requires DB_PATH). The managed g0efilter instance client is still planned.
# FLEET_ENABLED=true

# Optional
# BUFFER_SIZE=5000
# READ_LIMIT=5000
# SSE_RETRY_MS=2000
# RATE_RPS=50
# RATE_BURST=100

# Refer to README.md for more configuration options
