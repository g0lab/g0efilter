# Agent settings
FILTER_MODE=https
LOG_LEVEL=INFO
HOSTNAME=example-agent

# Dashboard connection
DASHBOARD_HOST=http://localhost:8081
# Must match API_KEY in .env.dashboard.
DASHBOARD_API_KEY=your-secure-api-key-here

# Optional: let dashboard users update this agent's policy.
# ENABLE_REMOTE_UNBLOCK=true

# Optional: alert on blocked egress. Any shoutrrr service works, space separated.
# These URLs embed a token, so keep them here rather than in docker-compose.yaml.
# NOTIFICATION_URLS=ntfy://ntfy.sh/my-topic

# Blocks that should not alert. See ../docs/configuration.md#notifications.
# NOTIFICATION_IGNORE_DOMAINS=local

# More settings: ../docs/configuration.md
