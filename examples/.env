# Agent settings
FILTER_MODE=https
LOG_LEVEL=INFO
HOSTNAME=example-agent

# Dashboard connection
DASHBOARD_HOST=http://localhost:8081
# Must match API_KEY in .env.dashboard.
DASHBOARD_API_KEY=your-secure-api-key-here

# Optional: let dashboard users update this agent's policy.
# ENABLE_REMOTE_UNBLOCK=true

# More settings: ../docs/configuration.md
