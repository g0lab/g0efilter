# Build the dashboard UI.
FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS ui

RUN corepack enable

WORKDIR /ui

COPY dashboard/ui/package.json dashboard/ui/pnpm-lock.yaml dashboard/ui/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY dashboard/ui/ ./
RUN pnpm build

# Build the dashboard binary with the UI.
FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY dashboard/go.mod dashboard/go.sum ./dashboard/
COPY shared/go.mod shared/go.sum ./shared/
RUN GOWORK=off go -C dashboard mod download

COPY . .
COPY --from=ui /ui/dist ./dashboard/ui/dist

ENV CGO_ENABLED=0 GOOS=linux
RUN GOWORK=off go -C dashboard build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter-dashboard .

# Create the runtime image.
FROM gcr.io/distroless/static:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

USER nonroot
# Create the data directory as the non-root user.
WORKDIR /app/data
WORKDIR /app

COPY --from=builder /build/g0efilter-dashboard /app/g0efilter-dashboard

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter-dashboard", "healthcheck"]

ENTRYPOINT ["/app/g0efilter-dashboard"]
