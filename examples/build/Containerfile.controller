# Build the Kubernetes controller. It is a separate Go module, so the build runs
# from the controller directory.
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY controller/go.mod controller/go.sum ./controller/
WORKDIR /build/controller
RUN go mod download

WORKDIR /build
COPY . .

WORKDIR /build/controller
ENV CGO_ENABLED=0 GOOS=linux
RUN go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter-controller .

FROM gcr.io/distroless/static:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3

COPY --from=builder /build/g0efilter-controller /g0efilter-controller

USER 65532:65532

ENTRYPOINT ["/g0efilter-controller"]
