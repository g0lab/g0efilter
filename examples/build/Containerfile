# Build the agent.
FROM golang:1.26.6-alpine3.23@sha256:5978cc992ad5ef96a7469713c8af849c1433824761ce3be2c56381403cd8d9a3 AS builder

ARG VERSION=dev
ARG COMMIT=unknown
ARG DATE=unknown

WORKDIR /build

COPY agent/go.mod agent/go.sum ./agent/
COPY shared/go.mod shared/go.sum ./shared/
RUN GOWORK=off go -C agent mod download

COPY . .

ENV CGO_ENABLED=0 GOOS=linux
RUN GOWORK=off go -C agent build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
    -o /build/g0efilter .

# Create the runtime image.
FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache nftables ca-certificates \
    && update-ca-certificates

WORKDIR /app

COPY --from=builder /build/g0efilter /app/g0efilter

# File capabilities let the agent program nftables without ever running as root. The
# nft binary needs its own: capabilities do not survive execve into a child process.
RUN apk add --no-cache --virtual .setcap libcap \
    && setcap cap_net_admin=eip /app/g0efilter \
    && setcap cap_net_admin=ep "$(command -v nft)" \
    && getcap /app/g0efilter | grep -q cap_net_admin \
    && getcap "$(command -v nft)" | grep -q cap_net_admin \
    && apk del .setcap

USER 65534:65534

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["/app/g0efilter", "healthcheck"]

ENTRYPOINT ["/app/g0efilter"]
